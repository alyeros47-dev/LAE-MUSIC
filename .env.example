# Configure through Render or your shell. The server does not auto-load this file.
NODE_ENV=production
PORT=3000
DATABASE_URL=
# Remote connections require verified TLS. Supply the reviewed PEM CA chain if needed.
# For Render private networking only: set private AND the exact internal URL hostname.
DATABASE_SSL_MODE=
DATABASE_PRIVATE_HOST=
PG_CA_CERT=
DATABASE_POOL_MAX=10
# At least 16 characters; use a long random value and keep it private.
ADMIN_KEY=
# Dedicated random 32-byte lowercase hex encryption key for named administrator MFA.
# Keep a secure backup. Configure before owner enrollment; do not reuse other secrets.
ADMIN_MFA_KEY=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
MUSICAPI_API_KEY=
OPENAI_API_KEY=
OPENAI_LYRICS_MODEL=gpt-6.1-sol
# No real payment-provider activation setting exists in this candidate.
# Legacy demo activation/withdrawal mutations are permanently disabled, including historical flags.

# Exact CDN hostnames from verified provider responses, comma-separated. No URLs, IPs or wildcards.
# Leave empty until the provider's real media origins have been verified. Imports stay unavailable.
GENERATED_MEDIA_ALLOWED_HOSTS=
# Set false for maintenance or isolated tests; new imports are then unavailable.
STUDIO_RELEASE_WORKER_ENABLED=true

# Daily USD reference estimates only; this does not activate payments.
# Use disabled to keep USD-only prices.
FX_RATE_SOURCE=exchangerate-api
# Flutterwave and Paystack have been selected. No gateway key or flag activates checkout yet.
# Merchant country, account-approved currencies and reviewed test/live credentials are still required.

# Nigeria is recorded in config/payment-merchant.json; account approvals remain empty/disabled.
# These are used only with a reviewed sandbox manifest and NODE_ENV=staging.
# Adding keys alone cannot enable checkout, and live mode is not supported.
PAYMENT_CALLBACK_ORIGIN=
PAYSTACK_SECRET_KEY=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_WEBHOOK_HASH=

# Account email is disabled by config/account-email.json until a transport is reviewed.
# SMTP requires port 465/TLS or 587/mandatory STARTTLS, a verified sender and HTTPS origin.
# ACCOUNT_EMAIL_KEY is a dedicated, random 32-byte key encoded as 64 lowercase hex characters.
# Retain it while queued envelopes exist; never reuse payment/session secrets.
SMTP_USER=
SMTP_PASSWORD=
ACCOUNT_EMAIL_KEY=

# Durable artist in-app subscription reminders in production/staging (no external delivery).
# Inbox access always checks due reminders for that authenticated artist.
ARTIST_NOTIFICATION_WORKER_ENABLED=true

# Website offline listening requires a dedicated P-256 private signing key and R2.
# PEM text or base64-encoded PEM, set through the host secret manager; never commit it.
# Generate without printing: node scripts/create-offline-key.cjs --output /secure/path/offline-key.txt
# Missing/invalid key disables offline grants without interrupting public streaming.
OFFLINE_LICENSE_PRIVATE_KEY=
# Free-listener ad creative is reviewed in config/listening-ads.json; disabled until an approved R2 asset exists.

# Only verified TCP proxy peers may supply X-Forwarded-For client addresses.
# Comma-separated exact IPs/CIDRs (max 32), not hosts or a wildcard /0.
# Empty means socket addresses only; never trust a header merely because it exists.
# Verify the real Render/proxy chain before configuring this in hosting settings.
TRUSTED_PROXY_CIDRS=
# In production/staging, request budgets use PostgreSQL with an automatically
# generated private fingerprint seed. The seed is never sent to clients/logs.
# Development/test uses bounded per-process memory; that is not a shared store.

# Owner-approved, persistent complimentary studio programme; enable only with the reviewed release.
LAE_ARTIST_TEST_ACCESS=0
