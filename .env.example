ADMIN_KEY=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
MUSICAPI_API_KEY=
OPENAI_API_KEY=
OPENAI_LYRICS_MODEL=gpt-4.1-mini
