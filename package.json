{
  "name": "lae-music",
  "version": "0.20.0-rc.20",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "start": "node server.js",
    "test": "node scripts/check-music-dna.cjs && node scripts/check-lae-integrity.cjs && node scripts/check-sonic-workflow.cjs && node scripts/test-sonic-handler.cjs && node tests/all.cjs",
    "test:dna": "node scripts/test-music-dna.cjs",
    "test:browser": "node scripts/test-browsers.cjs",
    "test:browser:all": "LAE_TEST_BROWSERS=chromium,firefox,webkit node scripts/test-browsers.cjs",
    "test:http": "LAE_NETWORK_TESTS=1 node tests/http.test.cjs",
    "test:postgres": "node tests/postgres.cjs && node tests/description-studio-postgres.cjs && node tests/open-studio-postgres.cjs",
    "test:upgrade": "node tests/upgrade-postgres.cjs",
    "preflight": "node scripts/preflight.cjs",
    "verify:fx": "node scripts/verify-public-fx.cjs",
    "test:email": "LAE_EMAIL_TESTS=1 node tests/smtp.test.cjs",
    "test:affiliate": "node --test tests/partner-policy.test.cjs tests/partner-demo.test.cjs tests/partner-accounting.test.cjs tests/platform.test.cjs tests/premium-international.test.cjs tests/financial-policy.test.cjs tests/services.test.cjs",
    "test:affiliate:postgres": "node tests/affiliate-purchase-year-postgres.cjs && node tests/affiliate-policy-regression-postgres.cjs",
    "test:affiliate:browser": "node tests/affiliate-purchase-year-browser.cjs",
    "test:membership": "node --test tests/artist-membership.test.cjs tests/commerce.test.cjs tests/artist-access.test.cjs tests/commissions.test.cjs",
    "test:membership:postgres": "node tests/artist-membership-migration.cjs && node tests/artist-membership-postgres.cjs",
    "test:membership:browser": "node tests/artist-membership-browser.cjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "jose": "^6.2.14",
    "nodemailer": "10.2.1",
    "pg": "^8.13.1",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.11.0",
    "playwright": "^1.56.1"
  }
}
