{
  "name": "lae-music",
  "version": "0.19.0-rc.19",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "start": "node server.js",
    "test": "node scripts/check-lae-integrity.cjs && node scripts/check-sonic-workflow.cjs && node scripts/test-sonic-handler.cjs && node tests/all.cjs",
    "test:browser": "node scripts/test-browsers.cjs",
    "test:browser:all": "LAE_TEST_BROWSERS=chromium,firefox,webkit node scripts/test-browsers.cjs",
    "test:http": "LAE_NETWORK_TESTS=1 node tests/http.test.cjs",
    "test:postgres": "node tests/postgres.cjs",
    "test:upgrade": "node tests/upgrade-postgres.cjs",
    "preflight": "node scripts/preflight.cjs",
    "verify:fx": "node scripts/verify-public-fx.cjs",
    "test:email": "LAE_EMAIL_TESTS=1 node tests/smtp.test.cjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "nodemailer": "10.2.1",
    "pg": "^8.13.1",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.11.0",
    "playwright": "^1.56.1"
  }
}
